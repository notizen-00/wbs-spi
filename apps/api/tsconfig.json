{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts", "../../packages/**/*.ts", "../worker/src/**/*.ts"],
  "exclude": ["../../packages/**/*.test.ts"]
}
