DATABASE_URL=postgres://postgres:@localhost:5432/wbs
# Optional: separate empty database for prisma migrate dev when CREATEDB is unavailable.
# SHADOW_DATABASE_URL=postgres://wbs:wbs_local_only@localhost:5432/wbs_shadow
REDIS_URL=redis://localhost:6379
# Redis Pub/Sub wakeup channel; notification history remains in PostgreSQL.
NOTIFICATION_REDIS_CHANNEL=wbs:notifications:v1
APP_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=WBS UNEJ <noreply@wbs.local>
# MinIO API endpoint (9000); console uses 9001.
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=wbs-private
MINIO_ACCESS_KEY=wbs_app
MINIO_SECRET_KEY=wbs_app_secret_local_only
# Root credentials are only used by the local MinIO server/bootstrap.
MINIO_ROOT_USER=wbs_local
MINIO_ROOT_PASSWORD=wbs_local_secret_only
# Existing S3_* settings remain supported as fallback when MINIO_* is absent.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Google reCAPTCHA v2 checkbox. Skipped only when NODE_ENV=development.
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional comma-separated hostnames. Defaults to the hostname in APP_ORIGIN.
# RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1
# Optional super-admin bootstrap. Production requires explicit email/password.
# SUPER_ADMIN_EMAIL=superadmin@example.test
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_PASSWORD=minimum_12_character_password
