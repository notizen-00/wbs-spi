# Local Docker stack: docker compose --env-file .env.docker -f manifest/docker-compose.app.yml up --build -d
# Keep DATABASE_URL in your native .env unchanged; these Docker-specific values override it in containers.
POSTGRES_DB=wbs
POSTGRES_USER=wbs
POSTGRES_PASSWORD=wbs_local_only
# Must match PostgreSQL credentials above. URL-encode special characters in user/password.
DOCKER_DATABASE_URL=postgres://wbs:wbs_local_only@postgres:5432/wbs
DOCKER_NODE_ENV=development
# Optional: intentionally shown on /demo in development. Match the demo SEED_PASSWORD.
# Never use a real account password or the super admin password here.
DEMO_PUBLIC_PASSWORD=
# Use 0.0.0.0 to allow access through the server IP.
DOCKER_WEB_BIND_ADDRESS=127.0.0.1
DOCKER_WEB_PORT=8081
DOCKER_APP_ORIGIN=http://localhost:8081
NOTIFICATION_REDIS_CHANNEL=wbs:notifications:v1
# Host port; containers still connect to redis:6379.
DOCKER_REDIS_PORT=6380

MINIO_REGION=us-east-1
MINIO_BUCKET=wbs-private
MINIO_ACCESS_KEY=wbs_app
MINIO_SECRET_KEY=wbs_app_secret_local_only
MINIO_ROOT_USER=wbs_local
MINIO_ROOT_PASSWORD=wbs_local_secret_only

DOCKER_SMTP_HOST=mailpit
DOCKER_SMTP_PORT=1025
SMTP_FROM=WBS UNEJ <noreply@wbs.local>
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Only required outside development. Register the hostname from DOCKER_APP_ORIGIN.
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional; defaults to hostname from DOCKER_APP_ORIGIN.
RECAPTCHA_ALLOWED_HOSTNAMES=

# Internal Redis, MinIO, ClamAV, and API ports are set by Compose.
# Native data/services are separate from Docker volumes.

# Docker Official Images on ECR Public; avoids Docker Hub for build base images.
NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
GO_BASE_IMAGE=public.ecr.aws/docker/library/golang:1.24-alpine
ALPINE_BASE_IMAGE=public.ecr.aws/docker/library/alpine:3.22
