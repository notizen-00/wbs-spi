{
  "name": "wbs-unej",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @wbs/api\" \"npm run dev -w @wbs/web\"",
    "build": "npm run build -w @wbs/api && npm run build -w @wbs/web",
    "test": "tsx --test packages/domain/src/*.test.ts tests/*.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "tsx apps/api/src/migrate.ts",
    "db:seed": "tsx apps/api/src/seed.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && npm run typecheck -w @wbs/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
