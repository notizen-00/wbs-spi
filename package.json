{
  "name": "wbs-unej",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @wbs/api\" \"npm run dev -w @wbs/web\"",
    "build": "npm run build -w @wbs/api && npm run build -w @wbs/web",
    "test": "tsx --test packages/domain/src/*.test.ts tests/*.test.ts",
    "test:browser": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "predb:seed": "npm run db:generate",
    "db:studio": "prisma studio",
    "predev": "npm run db:generate",
    "pretest": "npm run db:generate",
    "preworker": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "worker": "tsx apps/worker/src/main.ts",
    "storage:check": "tsx apps/api/src/storage/check.ts",
    "native:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/windows/Install-Native.ps1",
    "native:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/windows/Start-Native.ps1",
    "native:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/windows/Stop-Native.ps1",
    "native:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/windows/Status-Native.ps1",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && npm run typecheck -w @wbs/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
